@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="section-block">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="content-card text-center p-4 p-lg-5">
                    <span class="empty-state-icon"><i class="bi bi-signpost-split"></i></span>
                    <span class="eyebrow justify-content-center">MarketLink needs a moment</span>
                    <h1 class="display-6 fw-bold mb-3">We could not complete that request</h1>
                    <p class="text-muted lh-lg mb-4">The page may have moved, or a temporary issue interrupted the request. Return home or continue browsing this week's harvest.</p>
                    @if (Model.ShowRequestId)
                    {
                        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
                    }
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <a class="btn btn-market" asp-controller="Home" asp-action="Index">Return home</a>
                        <a class="btn btn-outline-market" asp-controller="Product" asp-action="Index">Browse product</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
