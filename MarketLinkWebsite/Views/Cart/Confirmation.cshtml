@{
    ViewData["Title"] = "Pre-order confirmed";
    var orderNumber = ViewData["OrderNumber"] as string ?? string.Empty;
    var pickupMarketName = ViewData["PickupMarketName"] as string ?? string.Empty;
    var pickupAddress = ViewData["PickupAddress"] as string ?? string.Empty;
    var pickupCity = ViewData["PickupCity"] as string ?? string.Empty;
    var pickupDate = ViewData["PickupDate"] as string ?? string.Empty;
    var pickupSlot = ViewData["PickupSlot"] as string ?? string.Empty;
    var orderTotal = Convert.ToDecimal(ViewData["OrderTotal"] ?? 0);
}

<section class="section-block">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="content-card text-center p-4 p-lg-5">
                    <span class="order-success-icon"><i class="bi bi-check-lg"></i></span>
                    <span class="eyebrow justify-content-center">Reservation received</span>
                    <h1 class="display-6 fw-bold mb-3">Your pre-order is confirmed</h1>
                    <p class="text-muted lh-lg mb-4">The grower will review your reservation and any available changes will appear in your customer dashboard.</p>
                    <span class="order-number mb-4">@orderNumber</span>

                    <div class="row g-3 text-start">
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 bg-light h-100">
                                <small class="text-muted d-block mb-1">Pickup market</small>
                                <strong>@pickupMarketName</strong>
                                <small class="d-block text-muted mt-1">@pickupAddress@(string.IsNullOrWhiteSpace(pickupCity) ? string.Empty : $", {pickupCity}")</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 bg-light h-100">
                                <small class="text-muted d-block mb-1">Pickup window</small>
                                <strong>@pickupDate</strong>
                                <small class="d-block text-muted mt-1">@pickupSlot</small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
                        <span class="text-muted">Total payable at pickup</span>
                        <strong class="fs-4">$@orderTotal.ToString("0.00")</strong>
                    </div>

                    <div class="alert alert-success d-flex gap-3 text-start mt-4 mb-4">
                        <i class="bi bi-bell-fill fs-4"></i>
                        <div><strong>What happens next?</strong><div class="small">You will receive an in-app notification when the farmer accepts your order and again when it is ready for collection.</div></div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <a class="btn btn-market" asp-controller="Customer" asp-action="Orders">View my orders</a>
                        <a class="btn btn-outline-market" asp-controller="Product" asp-action="Index">Continue shopping</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
