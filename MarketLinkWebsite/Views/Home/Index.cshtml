@model HomeViewModel
@{
    ViewData["Title"] = "Fresh local products, reserved for pickup";
    var productCount = Convert.ToInt32(ViewData["ProductCount"] ?? Model.FeaturedProducts.Count);
    var marketCount = Convert.ToInt32(ViewData["MarketCount"] ?? Model.Markets.Count);
    var nextMarket = ViewData["NextMarket"] as MarketCardViewModel;
    var nextMarketLabel = ViewData["NextMarketLabel"] as string ?? "Check the market calendar";
    var farms = ViewData["Farms"] as IReadOnlyList<FarmSpotlightViewModel> ?? Array.Empty<FarmSpotlightViewModel>();
}

<section class="home-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 hero-copy">
                <span class="hero-kicker"><i class="bi bi-patch-check-fill"></i> Trusted local growers · Transparent weekly availability</span>
                <p class="hero-clock" data-live-clock aria-live="off">
                    <i class="bi bi-calendar3"></i><span data-clock-date>Loading date</span>
                    <span class="hero-clock-sep" aria-hidden="true">·</span>
                    <i class="bi bi-clock"></i><span data-clock-time>--:--</span>
                </p>
                <h1 class="hero-title">Good food starts closer to <span class="highlight">home.</span></h1>
                <p class="hero-lead">Discover fresh products from farmers in your community, reserve what you love, and collect it directly from the market stall.</p>

                <div class="hero-actions">
                    <a class="btn btn-market px-4" asp-controller="Product" asp-action="Index">Explore this week's harvest <i class="bi bi-arrow-right"></i></a>
                    <a class="btn btn-outline-market px-4" asp-controller="Market" asp-action="Index"><i class="bi bi-map"></i> Find a market</a>
                </div>

                <form class="hero-search" asp-controller="Product" asp-action="Index" method="get">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-6">
                            <label class="visually-hidden" for="homeSearch">Search products or farms</label>
                            <div class="input-group">
                                <span class="input-group-text border-0 bg-transparent ps-2"><i class="bi bi-search text-success"></i></span>
                                <input id="homeSearch" class="form-control" name="searchQuery" placeholder="Search apples, honey, milk…" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="visually-hidden" for="homeDay">Market day</label>
                            <select id="homeDay" class="form-select" name="marketDay">
                                <option value="">Any market day</option>
                                <option value="Wednesday">Wednesday</option>
                                <option value="Saturday">Saturday</option>
                                <option value="Sunday">Sunday</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-market search-submit w-100" type="submit">Find product</button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-lg-5 hero-visual d-none d-md-block">
                <div class="hero-image-wrap">
                    <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1000&q=88" alt="Fresh seasonal vegetables at a local market" />
                </div>
                <div class="hero-float-card top">
                    <span class="float-icon"><i class="bi bi-basket2-heart"></i></span>
                    <div><strong>@productCount fresh products</strong><small>Available across @marketCount markets</small></div>
                </div>
                <div class="hero-float-card bottom">
                    <span class="float-icon"><i class="bi bi-geo-alt-fill"></i></span>
                    <div><strong>@(nextMarket?.Name ?? "Pickup calendar")</strong><small>@nextMarketLabel</small></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="trust-strip" aria-label="MarketLink benefits">
    <div class="container">
        <div class="row g-3">
            <div class="col-md-3"><div class="trust-item"><i class="bi bi-flower1"></i>Direct from nearby growers</div></div>
            <div class="col-md-3"><div class="trust-item"><i class="bi bi-box-seam"></i>Live weekly availability</div></div>
            <div class="col-md-3"><div class="trust-item"><i class="bi bi-calendar2-check"></i>Flexible pickup slots</div></div>
            <div class="col-md-3"><div class="trust-item"><i class="bi bi-cash-stack"></i>No online payment fees</div></div>
        </div>
    </div>
</section>

<section class="section-block">
    <div class="container">
        <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
            <div class="section-heading mb-lg-0">
                <span class="eyebrow">Shop the season</span>
                <h2 class="section-title">What tastes good this week?</h2>
                <p class="section-copy">Browse customer favourites across fruit, vegetables, dairy, bakery and pantry staples.</p>
            </div>
            <a class="btn btn-outline-market flex-shrink-0" asp-controller="Product" asp-action="Index">View all categories <i class="bi bi-arrow-right"></i></a>
        </div>

        @if (Model.Categories.Count > 0)
        {
            <div class="category-grid mb-5">
                @foreach (var category in Model.Categories)
                {
                    <a class="category-card reveal" asp-controller="Product" asp-action="Index" asp-route-category="@category.Name">
                        <span class="category-icon">
                            @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                            {
                                <img src="@category.ImageUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <i class="bi @category.IconClass"></i>
                            }
                        </span>
                        <strong>@category.Name</strong>
                        <small>@category.ProductCount item@(category.ProductCount == 1 ? string.Empty : "s")</small>
                    </a>
                }
            </div>
        }

        <div class="product-grid">
            @foreach (var product in Model.FeaturedProducts)
            {
                <form id="add-product-@product.Id" asp-controller="Cart" asp-action="Add" method="post" class="d-none">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="quantity" value="1" />
                </form>
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </div>
</section>

<section class="section-block pt-0">
    <div class="container">
        <div class="farmer-cta p-4 p-lg-5">
            <div class="row align-items-center g-4 position-relative">
                <div class="col-lg-8 farmer-cta-content">
                    <span class="eyebrow text-white-50">A market built around growers</span>
                    <h2>Know the hands and place behind your food.</h2>
                    <p>Every MarketLink profile gives you a clear view of the productr, their stall, operating days and the products available right now.</p>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a class="btn btn-light px-4" asp-controller="Market" asp-action="Index">Meet local farmers</a>
                        <a class="btn btn-outline-light px-4" asp-controller="Account" asp-action="FarmerRegister">Join as a farmer</a>
                    </div>
                </div>
                <div class="col-lg-4 text-center d-none d-lg-block">
                    <i class="bi bi-people display-1 text-white opacity-75"></i>
                </div>
            </div>
        </div>
    </div>
</section>

@if (farms.Count > 0)
{
    <section class="section-block pt-0">
        <div class="container">
            <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
                <div>
                    <span class="eyebrow">Our growers</span>
                    <h2 class="section-title mb-0">Meet the farmers selling this week</h2>
                    <p class="section-copy mb-0">Every farm is reviewed by our admin team before it can list product.</p>
                </div>
                <a class="btn btn-soft flex-shrink-0" asp-controller="Market" asp-action="Index">All markets <i class="bi bi-arrow-right"></i></a>
            </div>

            <div id="farmSpotlight" class="carousel slide farm-spotlight farm-spotlight-wrap" data-bs-ride="carousel" data-bs-interval="4500" data-bs-pause="hover" data-bs-wrap="true">
                <div class="carousel-inner">
                    @for (var index = 0; index < farms.Count; index += 4)
                    {
                        <div class="carousel-item @(index == 0 ? "active" : string.Empty)">
                            <div class="row g-3">
                                @foreach (var farm in farms.Skip(index).Take(4))
                                {
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <a class="farm-spotlight-card" asp-controller="Farm" asp-action="Index" asp-route-id="@farm.Id">
                                            <div class="farm-spotlight-head">
                                                <span class="farm-spotlight-avatar">
                                                    @if (!string.IsNullOrWhiteSpace(farm.ImageUrl))
                                                    {
                                                        <img src="@farm.ImageUrl" alt="@farm.FarmName" loading="lazy" />
                                                    }
                                                    else
                                                    {
                                                        @farm.Initials
                                                    }
                                                </span>
                                                <div class="min-w-0">
                                                    <h3 class="farm-spotlight-name text-truncate">@farm.FarmName</h3>
                                                    <span class="farm-spotlight-meta">
                                                        @farm.City
                                                        @if (farm.Rating > 0)
                                                        {
                                                            <span class="ms-1">· <i class="bi bi-star-fill text-warning"></i> @farm.Rating.ToString("0.0")</span>
                                                        }
                                                    </span>
                                                </div>
                                            </div>
                                            <p class="farm-spotlight-products mb-0">@farm.ProductNames</p>
                                            <div class="farm-spotlight-foot">
                                                <span class="farm-spotlight-count">@farm.ProductCount live</span>
                                                <span class="farm-spotlight-rating">View farm <i class="bi bi-arrow-right"></i></span>
                                            </div>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (farms.Count > 4)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#farmSpotlight" data-bs-slide="prev" aria-label="Previous farmers">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#farmSpotlight" data-bs-slide="next" aria-label="Next farmers">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                    <div class="carousel-indicators">
                        @for (var dot = 0; dot < (int)Math.Ceiling(farms.Count / 4.0); dot++)
                        {
                            <button type="button" data-bs-target="#farmSpotlight" data-bs-slide-to="@dot" class="@(dot == 0 ? "active" : string.Empty)" aria-label="Farmer slide @(dot + 1)"></button>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="section-block pt-0">
    <div class="container">
        <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 section-heading">
            <div>
                <span class="eyebrow">Pickup near you</span>
                <h2 class="section-title">Choose your market day</h2>
                <p class="section-copy">Plan your weekly shop around the markets and growers that suit your routine.</p>
            </div>
            <a class="btn btn-soft flex-shrink-0" asp-controller="Market" asp-action="Index">Open market map <i class="bi bi-map"></i></a>
        </div>

        <div class="market-grid">
            @foreach (var market in Model.Markets)
            {
                <partial name="_MarketCard" model="market" />
            }
        </div>
    </div>
</section>

<section class="section-block pt-0">
    <div class="container">
        <div class="section-heading text-center mx-auto">
            <span class="eyebrow justify-content-center">Simple by design</span>
            <h2 class="section-title">From field to basket in three steps</h2>
            <p class="section-copy mx-auto">No online checkout, no delivery fee and no guesswork about what is available.</p>
        </div>

        <div class="steps-grid">
            <article class="step-card reveal">
                <span class="step-number">01</span><span class="step-icon"><i class="bi bi-search-heart"></i></span>
                <h3>Discover what is fresh</h3>
                <p>Search by item, category, market or day and see current quantity from each grower.</p>
            </article>
            <article class="step-card reveal">
                <span class="step-number">02</span><span class="step-icon"><i class="bi bi-basket2"></i></span>
                <h3>Reserve your basket</h3>
                <p>Choose a pickup market, date and time slot. You can review everything before confirming.</p>
            </article>
            <article class="step-card reveal">
                <span class="step-number">03</span><span class="step-icon"><i class="bi bi-hand-index-thumb"></i></span>
                <h3>Collect and enjoy</h3>
                <p>Meet the grower at their stall, inspect your product and pay in cash at pickup.</p>
            </article>
        </div>
    </div>
</section>

<section class="pb-5">
    <div class="container">
        <div class="content-card d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4 p-4">
            <div>
                <span class="eyebrow">Market day reminder</span>
                <h2 class="h3 mb-2">Get the weekly harvest in your inbox.</h2>
                <p class="text-muted mb-0">A simple preview for market arrivals, seasonal product and pickup reminders.</p>
            </div>
            <form class="row g-2 flex-shrink-0 w-100" style="max-width: 500px;" data-demo-form>
                <div class="col-sm-8"><label class="visually-hidden" for="newsletterEmail">Email address</label><input id="newsletterEmail" class="form-control" type="email" placeholder="you@example.com" required /></div>
                <div class="col-sm-4"><button class="btn btn-market w-100" type="submit">Keep me posted</button></div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('[data-add-to-cart]').forEach(function (button) {
            const card = button.closest('.product-card');
            const detailsLink = card?.querySelector('a[href*="/Product/Details/"]');
            const match = detailsLink?.href.match(/\/Product\/Details\/(\d+)/i);
            const form = match ? document.getElementById(`add-product-${match[1]}`) : null;
            if (form) {
                button.type = 'submit';
                button.setAttribute('form', form.id);
            }
        });

        document.querySelector('[data-demo-form]')?.addEventListener('submit', function (event) {
            event.preventDefault();
            showToast('Thanks! Weekly market updates are ready for your inbox.');
            this.reset();
        });

        const clockDate = document.querySelector('[data-clock-date]');
        const clockTime = document.querySelector('[data-clock-time]');

        if (clockDate && clockTime) {
            const dateFormat = new Intl.DateTimeFormat(undefined, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
            const timeFormat = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit' });

            const tick = function () {
                const now = new Date();
                clockDate.textContent = dateFormat.format(now);
                clockTime.textContent = timeFormat.format(now);
            };

            tick();
            window.setInterval(tick, 1000);
        }
    </script>
}
