@model MarketLinkWebsite.Controllers.CustomerNotificationsViewModel
@{
    ViewData["Title"] = "Notifications";
}
@await Html.PartialAsync("_CustomerNav")

<div class="container-xl pb-5">
    @await Html.PartialAsync("_CustomerFlash")

    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
        <div>
            <div class="eyebrow text-uppercase fw-bold mb-1" style="color: var(--ml-accent-text); letter-spacing: .12em; font-size: .72rem;">Stay in the loop</div>
            <h1 class="display-6 fw-bold text-dark mb-2">Notifications</h1>
            <p class="text-muted mb-0">Helpful updates about your orders, saved items, and local market days.</p>
        </div>
        @if (Model.UnreadCount > 0)
        {
            <form asp-controller="Customer" asp-action="MarkAllNotificationsRead" method="post">
                <button type="submit" class="btn btn-outline-success rounded-pill fw-semibold" style="border-color: var(--ml-accent-text); color: var(--ml-accent-text);"><i class="bi bi-check2-all me-1" aria-hidden="true"></i>Mark all as read</button>
            </form>
        }
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-5 bg-white overflow-hidden">
                <div class="p-3 p-md-4 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex gap-1 flex-wrap" role="navigation" aria-label="Filter notifications">
                        @foreach (var filter in new[] { "All", "Unread", "Orders" })
                        {
                            <a class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.SelectedFilter == filter ? "text-white" : "btn-outline-secondary")" style="@(Model.SelectedFilter == filter ? "background:#4f772d;border-color:#4f772d;" : "")" asp-controller="Customer" asp-action="Notifications" asp-route-filter="@filter" aria-current="@(Model.SelectedFilter == filter ? "page" : null)">@filter</a>
                        }
                    </div>
                    <span class="small text-muted">@Model.FilteredCount shown</span>
                </div>
                @if (Model.Notifications.Count == 0)
                {
                    <div class="p-5 text-center"><div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 4rem; height: 4rem; background: var(--ml-sage-tint); color: var(--ml-accent-text);"><i class="bi bi-bell-slash fs-4" aria-hidden="true"></i></div><h2 class="h5 fw-bold text-dark">You’re all caught up</h2><p class="text-muted mb-0">There are no notifications in this view.</p></div>
                }
                else
                {
                    <div>
                        @foreach (var notification in Model.Notifications)
                        {
                            <article class="notification-row p-4 @(notification.IsRead ? "" : "unread")">
                                <div class="d-flex gap-3 align-items-start">
                                    <span class="d-inline-flex align-items-center justify-content-center rounded-3 flex-shrink-0 bg-@notification.Tone-subtle text-@notification.Tone" style="width: 2.7rem; height: 2.7rem;"><i class="bi @notification.Icon" aria-hidden="true"></i></span>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1"><h2 class="h6 fw-bold text-dark mb-0">@notification.Title</h2>@if (!notification.IsRead){<span class="notification-dot" aria-label="Unread"></span>}</div>
                                        <p class="small text-muted mb-2">@notification.Message</p>
                                        <div class="d-flex flex-wrap align-items-center gap-3"><span class="small text-muted">@notification.CreatedLabel</span><span class="badge rounded-pill bg-light text-muted border">@notification.Category</span></div>
                                    </div>
                                    <div class="d-flex flex-column align-items-end gap-2 flex-shrink-0">
                                        @if (!notification.IsRead)
                                        {
                                            <form asp-controller="Customer" asp-action="MarkNotificationRead" method="post"><input type="hidden" name="id" value="@notification.Id" /><button type="submit" class="btn btn-sm btn-link text-decoration-none p-0" style="color: var(--ml-accent-text); font-size: .75rem;" aria-label="Mark @notification.Title as read">Mark read</button></form>
                                        }
                                        @if (notification.ActionId > 0)
                                        {
                                            <a asp-controller="@notification.ActionController" asp-action="@notification.ActionName" asp-route-id="@notification.ActionId" asp-route-productId="@notification.ActionId" class="small fw-semibold text-decoration-none" style="color: var(--ml-accent-text);">View <i class="bi bi-arrow-up-right" aria-hidden="true"></i><span class="visually-hidden">@notification.Title</span></a>
                                        }
                                        else
                                        {
                                            <a asp-controller="@notification.ActionController" asp-action="@notification.ActionName" class="small fw-semibold text-decoration-none" style="color: var(--ml-accent-text);">Open <i class="bi bi-arrow-up-right" aria-hidden="true"></i><span class="visually-hidden">@notification.Title</span></a>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <section class="card border-0 shadow-sm rounded-5 bg-white p-4 p-md-5 mb-4" aria-labelledby="notification-preferences-heading">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 3rem; height: 3rem; background: var(--ml-sage-tint); color: var(--ml-accent-text);"><i class="bi bi-sliders" aria-hidden="true"></i></div>
                <h2 id="notification-preferences-heading" class="h5 fw-bold text-dark">Your notification center</h2>
                <p class="small text-muted">Order, account, review, and market updates are stored only for your account.</p>
                <div class="d-grid gap-3 small"><div class="d-flex justify-content-between align-items-center gap-2"><span>Unread updates</span><span class="badge rounded-pill soft-success">@Model.UnreadCount</span></div><div class="d-flex justify-content-between align-items-center gap-2"><span>Total updates</span><span class="badge rounded-pill bg-light text-muted border">@Model.TotalCount</span></div></div>
                <a asp-controller="Customer" asp-action="Profile" class="btn btn-sm btn-outline-success rounded-pill fw-semibold mt-4" style="border-color: var(--ml-accent-text); color: var(--ml-accent-text);">Review account details</a>
            </section>
            <div class="account-note rounded-4 p-3 d-flex gap-2 align-items-start small"><i class="bi bi-shield-check mt-1" aria-hidden="true"></i><span>We never expose notifications belonging to another customer, and read state is saved in your account.</span></div>
        </div>
    </div>
</div>

<style>
    .notification-row {
        border-bottom: 1px solid #edf2eb;
    }

    .notification-row:last-child {
        border-bottom: 0;
    }

    .notification-row.unread {
        background: #fbfdf9;
    }

    .notification-dot {
        width: .45rem;
        height: .45rem;
        display: inline-block;
        border-radius: 50%;
        background: #d96b4c;
    }

    .min-w-0 {
        min-width: 0;
    }

[data-theme="dark"] .notification-row {
    border-bottom-color: var(--ml-line-soft);
}

[data-theme="dark"] .notification-row.unread {
    background: var(--ml-surface-2);
}

[data-theme="dark"] .notification-row .badge.bg-light {
    background: var(--ml-surface-2) !important;
    color: var(--ml-ink-soft) !important;
}
</style>
