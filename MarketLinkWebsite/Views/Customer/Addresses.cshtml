@model MarketLinkWebsite.Controllers.AddressBookViewModel
@{
    ViewData["Title"] = "Saved addresses";
}
@await Html.PartialAsync("_CustomerNav")
@await Html.PartialAsync("../Account/_AccountStyles")

<div class="container-xl pb-5">
    @await Html.PartialAsync("_CustomerFlash")

    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
        <div>
            <div class="eyebrow text-uppercase fw-bold mb-1" style="color: var(--ml-accent-text); letter-spacing: .12em; font-size: .72rem;">Pickup preferences</div>
            <h1 class="display-6 fw-bold text-dark mb-2">Address book</h1>
            <p class="text-muted mb-0">Keep the places you meet your farmers ready for the next market.</p>
        </div>
        <a asp-controller="Customer" asp-action="Profile" class="btn btn-outline-success rounded-pill fw-semibold" style="border-color: var(--ml-accent-text); color: var(--ml-accent-text);"><i class="bi bi-person me-1" aria-hidden="true"></i>Back to profile</a>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-7">
            <section aria-labelledby="saved-address-list-heading">
                <div class="d-flex align-items-center justify-content-between mb-3"><h2 id="saved-address-list-heading" class="h4 fw-bold text-dark mb-0">Saved addresses</h2><span class="small text-muted">@Model.Addresses.Count addresses</span></div>
                @if (Model.Addresses.Count == 0)
                {
                    <div class="card border-0 shadow-sm rounded-5 bg-white p-5 text-center"><h3 class="h5 fw-bold text-dark">No saved addresses yet</h3><p class="text-muted mb-0">Add your first pickup address using the form.</p></div>
                }
                else
                {
                <div class="d-grid gap-3">
                    @foreach (var address in Model.Addresses)
                    {
                        <article class="card border-0 shadow-sm rounded-5 bg-white p-4">
                            <div class="d-flex align-items-start gap-3">
                                <span class="d-inline-flex align-items-center justify-content-center rounded-3 flex-shrink-0" style="width: 2.7rem; height: 2.7rem; background: var(--ml-sage-tint); color: var(--ml-accent-text);"><i class="bi bi-house-heart" aria-hidden="true"></i></span>
                                <div class="flex-grow-1"><div class="d-flex flex-wrap align-items-center gap-2 mb-2"><h3 class="h5 fw-bold text-dark mb-0">@address.Label</h3>@if (address.IsDefault){<span class="badge rounded-pill soft-success">Default</span>}</div><address class="small text-muted mb-2"><strong class="text-dark">@address.Recipient</strong><br />@address.AddressLine<br />@address.City, @address.Region @address.PostalCode</address><div class="small text-muted"><i class="bi bi-telephone me-1" aria-hidden="true"></i>@address.Phone</div></div>
                                <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                    @if (!address.IsDefault)
                                    {
                                        <form asp-controller="Customer" asp-action="MakeDefaultAddress" method="post">
                                            <input type="hidden" name="id" value="@address.Id" />
                                            <button type="submit" class="btn btn-sm btn-link text-decoration-none p-0" style="color: var(--ml-accent-text);">Make default</button>
                                        </form>
                                    }
                                    <form asp-controller="Customer" asp-action="DeleteAddress" method="post">
                                        <input type="hidden" name="id" value="@address.Id" />
                                        <button type="submit" class="btn btn-sm btn-link text-muted p-0" aria-label="Remove @address.Label address"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                </div>
                }
            </section>
        </div>

        <div class="col-lg-5">
            <section class="card border-0 shadow-sm rounded-5 bg-white p-4 p-md-5" aria-labelledby="add-address-heading">
                <div class="d-flex align-items-center gap-3 mb-4"><span class="d-inline-flex align-items-center justify-content-center rounded-3" style="width: 2.8rem; height: 2.8rem; background: var(--ml-amber-tint); color: var(--ml-accent-amber);"><i class="bi bi-plus-lg" aria-hidden="true"></i></span><div><div class="eyebrow text-uppercase fw-bold mb-1" style="color: var(--ml-accent-amber); letter-spacing: .12em; font-size: .72rem;">Add a place</div><h2 id="add-address-heading" class="h4 fw-bold text-dark mb-0">New address</h2></div></div>
                <p class="small text-muted mb-4">Addresses are used for order updates and pickup preferences.</p>
                <form asp-controller="Customer" asp-action="AddAddress" method="post" class="account-form">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-sm-6"><label asp-for="NewAddress.Label" class="form-label"></label><input type="text" required minlength="2" maxlength="40" pattern="[A-Za-z][A-Za-z0-9 &'.\-]*" title="Start with a letter." asp-for="NewAddress.Label" class="form-control" placeholder="Home" aria-describedby="address-label-error" /><span id="address-label-error" asp-validation-for="NewAddress.Label" class="text-danger small"></span></div>
                        <div class="col-sm-6"><label asp-for="NewAddress.Recipient" class="form-label"></label><input type="text" required minlength="2" maxlength="100" pattern="[A-Za-z][A-Za-z'\-.]*" title="Start with a letter, then letters only." asp-for="NewAddress.Recipient" class="form-control" autocomplete="name" placeholder="Maya Santos" aria-describedby="address-recipient-error" /><span id="address-recipient-error" asp-validation-for="NewAddress.Recipient" class="text-danger small"></span></div>
                        <div class="col-12"><label asp-for="NewAddress.AddressLine" class="form-label"></label><input type="text" required minlength="5" maxlength="250" pattern="[A-Za-z0-9 ,.\-'#]{5,150}" title="Enter at least 5 characters." asp-for="NewAddress.AddressLine" class="form-control" autocomplete="street-address" placeholder="218 Willow Creek Lane" aria-describedby="address-street-error" /><span id="address-street-error" asp-validation-for="NewAddress.AddressLine" class="text-danger small"></span></div>
                        <div class="col-sm-7"><label asp-for="NewAddress.City" class="form-label"></label><input type="text" required minlength="2" maxlength="100" pattern="[A-Za-z][A-Za-z0-9 &'.\-]*" title="Start with a letter." asp-for="NewAddress.City" class="form-control" autocomplete="address-level2" placeholder="Northbridge" aria-describedby="address-city-error" /><span id="address-city-error" asp-validation-for="NewAddress.City" class="text-danger small"></span></div>
                        <div class="col-sm-5"><label asp-for="NewAddress.Region" class="form-label"></label><input type="text" required minlength="2" maxlength="100" pattern="[A-Za-z][A-Za-z0-9 &'.\-]*" title="Start with a letter." asp-for="NewAddress.Region" class="form-control" autocomplete="address-level1" placeholder="OR" aria-describedby="address-region-error" /><span id="address-region-error" asp-validation-for="NewAddress.Region" class="text-danger small"></span></div>
                        <div class="col-sm-6"><label asp-for="NewAddress.PostalCode" class="form-label"></label><input type="text" required minlength="3" maxlength="20" pattern="[A-Za-z0-9][A-Za-z0-9 \-]{2,9}" title="Enter 3 to 10 letters or digits." asp-for="NewAddress.PostalCode" class="form-control" autocomplete="postal-code" placeholder="97218" aria-describedby="address-postal-error" /><span id="address-postal-error" asp-validation-for="NewAddress.PostalCode" class="text-danger small"></span></div>
                        <div class="col-sm-6"><label asp-for="NewAddress.Phone" class="form-label"></label><input type="tel" required maxlength="30" pattern="\+?[0-9][0-9 \-()]{6,20}" title="Use 7 to 21 characters. Digits, spaces, brackets, plus and hyphens only." asp-for="NewAddress.Phone" class="form-control" autocomplete="tel" placeholder="(555) 014-2088" aria-describedby="address-phone-error" /><span id="address-phone-error" asp-validation-for="NewAddress.Phone" class="text-danger small"></span></div>
                    </div>
                        <div class="col-12 mt-3">
                            @await Html.PartialAsync("_LocationPicker", new MarketLinkWebsite.Models.ViewModels.LocationPickerViewModel
                            {
                                Suffix = "address",
                                Title = "Pin this address on the map",
                                Hint = "We use this to show the markets, farmers and products closest to you.",
                                Latitude = Model.NewAddress.Latitude,
                                Longitude = Model.NewAddress.Longitude
                            })
                        </div>
                    <div class="form-check mt-4"><input asp-for="NewAddress.IsDefault" class="form-check-input" type="checkbox" /><label asp-for="NewAddress.IsDefault" class="form-check-label small text-muted"></label></div>
                    <button type="submit" class="btn btn-brand w-100 mt-4">Save address <i class="bi bi-check2 ms-1" aria-hidden="true"></i></button>
                </form>
            </section>
            <div class="account-note rounded-4 p-3 mt-3 d-flex gap-2 align-items-start small"><i class="bi bi-info-circle mt-1" aria-hidden="true"></i><span>MarketLink never displays your full address publicly. It is only used for your market experience.</span></div>
        </div>
    </div>
</div>
