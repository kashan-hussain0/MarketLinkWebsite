@model MarketLinkWebsite.Controllers.ForgotPasswordForm
@{
    ViewData["Title"] = "Reset your password";
}
@await Html.PartialAsync("_AccountStyles")

<div class="account-page py-4 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5">
                <div class="account-card bg-white p-4 p-sm-5 text-center">
                    <a class="d-inline-flex align-items-center gap-2 text-decoration-none mb-5" asp-controller="Home" asp-action="Index" aria-label="MarketLink home">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-3 text-white" style="width: 2.6rem; height: 2.6rem; background: var(--ml-leaf-solid);"><i class="bi bi-shop-window" aria-hidden="true"></i></span>
                        <span class="fs-5 fw-bold" style="color: var(--ml-ink-strong);">Market<span style="color: var(--ml-accent-text);">Link</span></span>
                    </a>
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4" style="width: 4.5rem; height: 4.5rem; background: var(--ml-sage-tint); color: var(--ml-accent-text);">
                        <i class="bi bi-key fs-2" aria-hidden="true"></i>
                    </div>
                    <div class="eyebrow text-uppercase fw-bold mb-2" style="color: var(--ml-accent-text); letter-spacing: .12em; font-size: .72rem;">Account recovery</div>
                    <h1 class="fw-bold text-dark mb-2">Forgot your password?</h1>
                    <p class="text-muted mb-4">Enter the email address linked to your account and we will send a six digit code to it.</p>

                    @if (ViewData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 border-0 rounded-3 text-start" role="alert">
                            <i class="bi bi-exclamation-circle-fill mt-1" aria-hidden="true"></i>
                            <span>@errorMessage</span>
                        </div>
                    }

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="account-form text-start">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0" role="alert"></div>
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0" style="border-color: var(--ml-line-soft); color: var(--ml-accent-text);"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                                <input asp-for="Email" class="form-control border-start-0" autocomplete="email" inputmode="email" placeholder="you@example.com" aria-describedby="forgot-email-error" />
                            </div>
                            <span id="forgot-email-error" asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-brand w-100">
                            Send my code <i class="bi bi-send ms-1" aria-hidden="true"></i>
                        </button>
                    </form>

                    <div class="account-divider my-4">Need a different account?</div>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success w-100 fw-semibold rounded-3 py-2" style="border-color: var(--ml-accent-text); color: var(--ml-accent-text);">Back to log in</a>
                    <p class="small text-muted mt-4 mb-0">Remembered it? <a asp-controller="Account" asp-action="Login" class="fw-semibold" style="color: var(--ml-accent-text);">Return to your account</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
