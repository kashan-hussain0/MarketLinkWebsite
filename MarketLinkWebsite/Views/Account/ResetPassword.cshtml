@model MarketLinkWebsite.Controllers.ResetPasswordForm
@{
    ViewData["Title"] = "Choose a new password";
}
@await Html.PartialAsync("_AccountStyles")

<div class="account-page py-4 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5">
                <div class="account-card bg-white p-4 p-sm-5 text-center">
                    <a class="d-inline-flex align-items-center gap-2 text-decoration-none mb-5" asp-controller="Home" asp-action="Index" aria-label="MarketLink home">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-3 text-white" style="width: 2.6rem; height: 2.6rem; background: var(--ml-leaf-solid);"><i class="bi bi-shop-window" aria-hidden="true"></i></span>
                        <span class="fs-5 fw-bold" style="color: var(--ml-ink-strong);">Market<span style="color: var(--ml-accent-text);">Link</span></span>
                    </a>
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4" style="width: 4.5rem; height: 4.5rem; background: var(--ml-sage-tint); color: var(--ml-accent-text);">
                        <i class="bi bi-shield-lock fs-2" aria-hidden="true"></i>
                    </div>
                    <div class="eyebrow text-uppercase fw-bold mb-2" style="color: var(--ml-accent-text); letter-spacing: .12em; font-size: .72rem;">Account recovery</div>
                    <h1 class="fw-bold text-dark mb-2">Choose a new password</h1>
                    <p class="text-muted mb-4">
                        Your code was accepted for <strong class="text-dark">@Model.Email</strong>.
                        Pick a strong password you do not use anywhere else.
                    </p>

                    @if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
                    {
                        <div class="alert alert-success d-flex align-items-start gap-2 border-0 rounded-3 text-start" role="status">
                            <i class="bi bi-check-circle-fill mt-1" aria-hidden="true"></i>
                            <span>@successMessage</span>
                        </div>
                    }

                    @if (ViewData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 border-0 rounded-3 text-start" role="alert">
                            <i class="bi bi-exclamation-circle-fill mt-1" aria-hidden="true"></i>
                            <span>@errorMessage</span>
                        </div>
                    }

                    <form asp-controller="Account" asp-action="ResetPassword" method="post" class="account-form text-start">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0" role="alert"></div>
                        <input asp-for="Email" type="hidden" />
                        <input asp-for="Code" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0" style="border-color: var(--ml-line-soft); color: var(--ml-accent-text);"><i class="bi bi-lock" aria-hidden="true"></i></span>
                                <input asp-for="Password" class="form-control border-start-0" autocomplete="new-password" aria-describedby="reset-password-help reset-password-error" />
                            </div>
                            <div id="reset-password-help" class="form-text">Use at least 8 characters with uppercase, lowercase, a number, and a symbol.</div>
                            <span id="reset-password-error" asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0" style="border-color: var(--ml-line-soft); color: var(--ml-accent-text);"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control border-start-0" autocomplete="new-password" aria-describedby="reset-confirm-error" />
                            </div>
                            <span id="reset-confirm-error" asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-brand w-100">
                            Update password <i class="bi bi-check2 ms-1" aria-hidden="true"></i>
                        </button>
                    </form>

                    <p class="small text-muted mt-4 mb-0"><a class="fw-semibold" asp-controller="Account" asp-action="Login" style="color: var(--ml-accent-text);">Return to log in</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
