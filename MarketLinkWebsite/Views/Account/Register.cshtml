@model MarketLinkWebsite.Controllers.CustomerRegistrationForm
@{
    ViewData["Title"] = "Create your account";
}
@await Html.PartialAsync("_AccountStyles")

<div class="account-page py-4 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10 col-lg-11">
                <div class="account-card bg-white">
                    <div class="row g-0">
                        <div class="col-lg-4 account-visual p-4 p-md-5 d-flex flex-column">
                            <a class="d-inline-flex align-items-center gap-2 text-white text-decoration-none" asp-controller="Home" asp-action="Index" aria-label="MarketLink home">
                                <span class="account-brand-mark"><i class="bi bi-shop-window fs-4" aria-hidden="true"></i></span>
                                <span class="fs-5 fw-bold">Market<span class="fw-light">Link</span></span>
                            </a>
                            <div class="py-5 my-4 position-relative" style="z-index: 1;">
                                <div class="eyebrow mb-3">Your weekly market companion</div>
                                <h1 class="display-6 fw-bold text-white lh-sm mb-3">More local. More connected.</h1>
                                <p class="mb-4" style="color: rgba(255,255,255,.78);">Create a free account to keep your orders, addresses, and favorite growers in one calm place.</p>
                                <div class="vstack gap-3">
                                    <div class="account-feature"><i class="bi bi-calendar2-week" aria-hidden="true"></i><span>See what is fresh before the market opens.</span></div>
                                    <div class="account-feature"><i class="bi bi-bell" aria-hidden="true"></i><span>Get helpful pickup and order reminders.</span></div>
                                    <div class="account-feature"><i class="bi bi-people" aria-hidden="true"></i><span>Discover the people behind your food.</span></div>
                                </div>
                            </div>
                            <div class="small mt-auto position-relative" style="z-index: 1; color: rgba(255,255,255,.62);">
                                <i class="bi bi-flower1 me-1" aria-hidden="true"></i>
                                Grown nearby. Shared generously.
                            </div>
                        </div>

                        <div class="col-lg-8 p-4 p-sm-5">
                            <a class="d-inline-flex align-items-center small fw-semibold text-decoration-none mb-4" asp-controller="Account" asp-action="Login" style="color: var(--ml-accent-text);">
                                <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                                Already have an account? Log in
                            </a>
                            <div class="eyebrow text-uppercase fw-bold mb-2" style="color: var(--ml-accent-text); letter-spacing: .12em; font-size: .72rem;">Customer registration</div>
                            <h2 class="fw-bold text-dark mb-2">Create your MarketLink account</h2>
                            <p class="text-muted mb-4">It takes less than a minute to get started.</p>

                            @if (ViewData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <div class="alert alert-danger d-flex align-items-start gap-2 border-0 rounded-3" role="alert">
                                    <i class="bi bi-exclamation-circle-fill mt-1" aria-hidden="true"></i>
                                    <span>@errorMessage</span>
                                </div>
                            }

                            <form asp-controller="Account" asp-action="Register" method="post" class="account-form">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0" role="alert"></div>
                                <fieldset>
                                    <legend class="h6 fw-bold text-dark mb-3">Your details</legend>
                                    <div class="row g-3">
                                        <div class="col-sm-6">
                                            <label asp-for="FirstName" class="form-label"></label>
                                            <input asp-for="FirstName" type="text" required minlength="2" maxlength="50" pattern="[A-Za-z][A-Za-z'\-.]*" title="Start with a letter, then letters, spaces, hyphens or dots only." class="form-control" autocomplete="given-name" placeholder="Maya" aria-describedby="register-first-name-error" />
                                            <span id="register-first-name-error" asp-validation-for="FirstName" class="text-danger small"></span>
                                        </div>
                                        <div class="col-sm-6">
                                            <label asp-for="LastName" class="form-label"></label>
                                            <input asp-for="LastName" type="text" required minlength="2" maxlength="50" pattern="[A-Za-z][A-Za-z'\-.]*" title="Start with a letter, then letters, spaces, hyphens or dots only." class="form-control" autocomplete="family-name" placeholder="Santos" aria-describedby="register-last-name-error" />
                                            <span id="register-last-name-error" asp-validation-for="LastName" class="text-danger small"></span>
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="Email" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0" style="border-color: var(--ml-line-soft); color: var(--ml-accent-text);"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                                                <input asp-for="Email" type="email" required maxlength="256" spellcheck="false" class="form-control autocomplete="email" inputmode="email" placeholder="you@example.com" aria-describedby="register-email-error" />
                                            </div>
                                            <span id="register-email-error" asp-validation-for="Email" class="text-danger small"></span>
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="PhoneNumber" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0" style="border-color: var(--ml-line-soft); color: var(--ml-accent-text);"><i class="bi bi-telephone" aria-hidden="true"></i></span>
                                                <input asp-for="PhoneNumber" type="tel" required maxlength="30" pattern="\+?[0-9][0-9 \-()]{6,20}" title="Use 7 to 21 characters. Digits, spaces, brackets, plus and hyphens only." autocomplete="tel" inputmode="tel" class="form-control border-start-0" autocomplete="tel" inputmode="tel" placeholder="(555) 014-2088" aria-describedby="register-phone-error" />
                                            </div>
                                            <span id="register-phone-error" asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <fieldset class="mt-4">
                                        <legend class="h6 fw-bold text-dark mb-3">Your primary address</legend>
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <label asp-for="AddressLine" class="form-label"></label>
                                                <input asp-for="AddressLine" type="text" required minlength="5" maxlength="250" pattern="[A-Za-z0-9 ,.\-'#]{5,150}" title="Enter at least 5 characters, using letters, digits, spaces and the usual punctuation." class="form-control" autocomplete="street-address" placeholder="218 Willow Creek Lane" aria-describedby="register-address-error" />
                                                <span id="register-address-error" asp-validation-for="AddressLine" class="text-danger small"></span>
                                            </div>
                                            <div class="col-sm-5">
                                                <label asp-for="City" class="form-label"></label>
                                                <input asp-for="City" type="text" required minlength="2" maxlength="100" pattern="[A-Za-z][A-Za-z0-9 &'.\-]*" title="Start with a letter." class="form-control" autocomplete="address-level2" placeholder="Northbridge" aria-describedby="register-city-error" />
                                                <span id="register-city-error" asp-validation-for="City" class="text-danger small"></span>
                                            </div>
                                            <div class="col-sm-3">
                                                <label asp-for="Region" class="form-label"></label>
                                                <input asp-for="Region" type="text" required minlength="2" maxlength="100" pattern="[A-Za-z][A-Za-z'\-.]*" title="Start with a letter." class="form-control" autocomplete="address-level1" placeholder="OR" aria-describedby="register-region-error" />
                                                <span id="register-region-error" asp-validation-for="Region" class="text-danger small"></span>
                                            </div>
                                            <div class="col-sm-4">
                                                <label asp-for="PostalCode" class="form-label"></label>
                                                <input asp-for="PostalCode" type="text" required minlength="3" maxlength="20" pattern="[A-Za-z0-9][A-Za-z0-9 \-]{2,9}" title="Enter 3 to 10 letters or digits, with optional spaces or hyphens." class="form-control" autocomplete="postal-code" placeholder="97218" aria-describedby="register-postal-error" />
                                                <span id="register-postal-error" asp-validation-for="PostalCode" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </fieldset>
                                </fieldset>

                                <fieldset class="mt-4">
                                    <legend class="h6 fw-bold text-dark mb-3">Choose a password</legend>
                                    <div class="row g-3">
                                        <div class="col-sm-6">
                                            <label asp-for="Password" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0" style="border-color: var(--ml-line-soft); color: var(--ml-accent-text);"><i class="bi bi-lock" aria-hidden="true"></i></span>
                                                <input asp-for="Password" type="password" required minlength="8" maxlength="100" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).{8,100}" title="Use at least 8 characters with an uppercase letter, a lowercase letter, a number and a symbol." autocomplete="new-password" data-password-meter="true" class="form-control border-start-0" autocomplete="new-password" placeholder="At least 8 characters" aria-describedby="register-password-help register-password-error" />
                                            </div>
                                            <div id="register-password-help" class="form-text">Use 8 or more characters with uppercase, lowercase, a number, and a symbol.</div>
                                            <div class="account-strength mt-2">
                                                <div class="account-strength-bar"><span data-password-strength-bar></span></div>
                                                <div class="d-flex justify-content-between gap-2">
                                                    <small class="text-muted" data-password-strength-label>Use 8 or more characters with uppercase, lowercase, a number, and a symbol.</small>
                                                    <small class="text-muted text-nowrap" data-password-strength-count></small>
                                                </div>
                                            </div>
                                            <span id="register-password-error" asp-validation-for="Password" class="text-danger small"></span>
                                        </div>
                                        <div class="col-sm-6">
                                            <label asp-for="ConfirmPassword" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0" style="border-color: var(--ml-line-soft); color: var(--ml-accent-text);"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
                                                <input asp-for="ConfirmPassword" type="password" required minlength="8" maxlength="100" autocomplete="new-password" data-password-match="Password" class="form-control border-start-0" autocomplete="new-password" placeholder="Repeat your password" aria-describedby="register-confirm-password-error" />
                                            </div>
                                            <span id="register-confirm-password-error" asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                            <div class="small mt-1" data-password-match-for="ConfirmPassword"></div>
                                        </div>
                                    </div>
                                </fieldset>

                                <div class="mt-4 pt-3 border-top">
                                    <div class="form-check mb-0">
                                        <input asp-for="AcceptTerms" class="form-check-input" type="checkbox" required data-val-required="Tick the box to accept the terms and the privacy policy." aria-describedby="register-terms-error" />
                                        <label asp-for="AcceptTerms" class="form-check-label small text-muted">I agree to the MarketLink terms and privacy policy</label>
                                        <span id="register-terms-error" asp-validation-for="AcceptTerms" class="text-danger small d-block"></span>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    @await Html.PartialAsync("_LocationPicker", new MarketLinkWebsite.Models.ViewModels.LocationPickerViewModel
                                    {
                                        Suffix = "register",
                                        Title = "Where should we show you what is near you?",
                                        Hint = "Pick your current location so markets, farmers and products are ordered by distance.",
                                        Latitude = Model.Latitude,
                                        Longitude = Model.Longitude
                                    })
                                </div>

                                <button type="submit" class="btn btn-brand w-100 mt-4">
                                    Create customer account <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                                </button>
                            </form>

                            <div class="account-note small d-flex gap-2 align-items-start mt-4 p-3">
                                <i class="bi bi-shield-check mt-1" aria-hidden="true"></i>
                                <span>Your account and primary address are stored securely in your MarketLink profile.</span>
                            </div>

                            <div class="text-center mt-4 pt-3 border-top">
                                <p class="small text-muted mb-2">Growing something good?</p>
                                <a asp-controller="Account" asp-action="FarmerRegister" class="fw-semibold text-decoration-none" style="color: var(--ml-accent-text);">Join MarketLink as a farmer <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
