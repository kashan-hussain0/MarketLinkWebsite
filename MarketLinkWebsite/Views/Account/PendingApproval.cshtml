@{
    ViewData["Title"] = "Farmer approval pending";
}
@await Html.PartialAsync("_AccountStyles")

<div class="account-page py-4 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-7 col-xl-6">
                <div class="account-card bg-white p-4 p-sm-5 text-center">
                    <a class="d-inline-flex align-items-center gap-2 text-decoration-none mb-5" asp-controller="Home" asp-action="Index" aria-label="MarketLink home">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-3 text-white" style="width: 2.6rem; height: 2.6rem; background: var(--ml-leaf-solid);"><i class="bi bi-shop-window" aria-hidden="true"></i></span>
                        <span class="fs-5 fw-bold" style="color: var(--ml-ink-strong);">Market<span style="color: var(--ml-accent-text);">Link</span></span>
                    </a>
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4" style="width: 5rem; height: 5rem; background: var(--ml-amber-tint); color: var(--ml-accent-amber);">
                        <i class="bi bi-hourglass-split fs-1" aria-hidden="true"></i>
                    </div>
                    <div class="eyebrow text-uppercase fw-bold mb-2" style="color: var(--ml-accent-amber); letter-spacing: .12em; font-size: .72rem;">Farmer application</div>
                    <h1 class="fw-bold text-dark mb-3">Your farm profile is pending approval</h1>
                    <p class="text-muted mb-4">Your account and farm details are saved. A MarketLink administrator must approve the profile before seller products and workspace tools become available.</p>

                    @if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
                    {
                        <div class="alert alert-success d-flex align-items-start gap-2 border-0 rounded-3 text-start" role="status">
                            <i class="bi bi-check-circle-fill mt-1" aria-hidden="true"></i>
                            <span>@successMessage</span>
                        </div>
                    }

                    <div class="account-note small d-flex gap-2 align-items-start text-start p-3 mb-4">
                        <i class="bi bi-shield-check mt-1" aria-hidden="true"></i>
                        <span>Approval status is stored on your farmer profile and is checked again each time you log in.</span>
                    </div>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-brand px-4" style="background: var(--ml-leaf-solid); border-color: var(--ml-accent-text); color: #fff;">Explore the market</a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-success w-100 px-4" style="border-color: var(--ml-accent-text); color: var(--ml-accent-text);">Log out</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
