@model FarmerProfileViewModel
@{
    ViewData["Title"] = "Farm profile";
}

<div class="farmer-page-header">
    <div>
        <div class="farmer-page-kicker">YOUR STORY</div>
        <h1 class="farmer-page-title">Farm profile</h1>
        <p class="farmer-page-subtitle">Help neighbors get to know the people and practices behind your product.</p>
    </div>
    <div class="farmer-page-actions">
        <a class="farmer-btn farmer-btn-secondary" asp-area="Farmer" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-eye" aria-hidden="true"></i> Back to dashboard</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <div class="farmer-alert farmer-alert-success" role="status">
        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
        <span>@Model.Notice</span>
    </div>
}

<form method="post" asp-area="Farmer" asp-controller="Profile" asp-action="Update" enctype="multipart/form-data" class="farmer-profile-form">
    <div asp-validation-summary="All" class="farmer-alert farmer-alert-danger" role="alert"></div>
    <div class="row g-4 align-items-start">
        <div class="col-12 col-xl-4">
            <aside class="farmer-profile-side">
                <section class="farmer-profile-hero">
                    <img src="@Model.FarmImageUrl" alt="@Model.FarmName landscape" />
                    <div class="farmer-profile-hero-overlay"></div>
                    <span class="farmer-verified-pill"><i class="bi bi-patch-check-fill" aria-hidden="true"></i> @Model.VerificationStatus</span>
                </section>
                <section class="farmer-panel farmer-profile-card">
                    <div class="farmer-profile-card-heading">
                        <span class="farmer-profile-avatar">@Model.OwnerInitials</span>
                        <div><span class="farmer-panel-eyebrow">FARMER SINCE</span><strong>@Model.MemberSince</strong></div>
                    </div>
                    <h2>@Model.FarmName</h2>
                    <p>@Model.Bio</p>
                    <div class="farmer-profile-stats">
                        <div><strong>@Model.Rating.ToString("0.0")</strong><span><i class="bi bi-star-fill" aria-hidden="true"></i> rating</span></div>
                        <div><strong>@Model.ListingCount</strong><span>listings</span></div>
                        <div><strong>@Model.FollowerCount</strong><span>followers</span></div>
                    </div>
                </section>
                <section class="farmer-profile-completion">
                    <div class="d-flex justify-content-between align-items-center mb-2"><strong>Profile strength</strong><span>@Model.ProfileStrength%</span></div>
                    <div class="progress" role="progressbar" aria-label="Profile strength" aria-valuenow="@Model.ProfileStrength" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width: @Model.ProfileStrength%"></div></div>
                    <small>@(Model.ProfileStrength >= 80 ? "Your profile is ready for neighbors." : "Add a few more details to make your profile stand out.")</small>
                </section>
            </aside>
        </div>

        <div class="col-12 col-xl-8">
            <section class="farmer-panel farmer-form-panel" aria-labelledby="farm-details-heading">
                <div class="farmer-form-section-heading">
                    <span class="farmer-form-step">01</span>
                    <div>
                        <h2 id="farm-details-heading">Farm details</h2>
                        <p>This information appears on your public farm storefront.</p>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <label class="form-label farmer-form-label" asp-for="FarmName">Farm name</label>
                        <input class="form-control farmer-form-control" asp-for="FarmName" required />
                        <span class="text-danger farmer-validation" asp-validation-for="FarmName"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label farmer-form-label" asp-for="OwnerName">Your name</label>
                        <input class="form-control farmer-form-control" asp-for="OwnerName" required />
                        <span class="text-danger farmer-validation" asp-validation-for="OwnerName"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label farmer-form-label" asp-for="Bio">About your farm</label>
                        <textarea class="form-control farmer-form-control farmer-textarea" asp-for="Bio" rows="4" required></textarea>
                        <div class="d-flex justify-content-between"><span class="farmer-form-hint">Share your growing philosophy or what makes your farm special.</span><span class="farmer-form-hint">600 characters max</span></div>
                        <span class="text-danger farmer-validation" asp-validation-for="Bio"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label farmer-form-label" asp-for="FarmImageFile">Farm photo</label>
                        <input class="form-control farmer-form-control" asp-for="FarmImageFile" type="file" accept="image/*" />
                        <span class="farmer-form-hint">Any picture &mdash; JPG, PNG, GIF, WEBP, BMP, TIFF, AVIF, HEIC or SVG, up to 8 MB.</span>
                        <span class="text-danger farmer-validation" asp-validation-for="FarmImageFile"></span>
                    </div>
                </div>
            </section>

            <section class="farmer-panel farmer-form-panel mt-4" aria-labelledby="contact-details-heading">
                <div class="farmer-form-section-heading">
                    <span class="farmer-form-step">02</span>
                    <div>
                        <h2 id="contact-details-heading">Contact &amp; pickup</h2>
                        <p>Only your pickup details are shared with confirmed orders.</p>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <label class="form-label farmer-form-label" asp-for="Email">Email address</label>
                        <div class="farmer-input-with-icon"><i class="bi bi-envelope" aria-hidden="true"></i><input class="form-control farmer-form-control" asp-for="Email" type="email" required /></div>
                        <span class="text-danger farmer-validation" asp-validation-for="Email"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label farmer-form-label" asp-for="Phone">Phone number</label>
                        <div class="farmer-input-with-icon"><i class="bi bi-telephone" aria-hidden="true"></i><input class="form-control farmer-form-control" asp-for="Phone" type="tel" required /></div>
                        <span class="text-danger farmer-validation" asp-validation-for="Phone"></span>
                    </div>
                    <div class="col-12 col-md-7">
                        <label class="form-label farmer-form-label" asp-for="Address">Farm / pickup address</label>
                        <div class="farmer-input-with-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i><input class="form-control farmer-form-control" asp-for="Address" required /></div>
                        <span class="farmer-form-hint">Your exact address is only shown to customers with a confirmed pickup order.</span>
                        <span class="text-danger farmer-validation" asp-validation-for="Address"></span>
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label farmer-form-label" asp-for="City">City</label>
                        <div class="farmer-input-with-icon"><i class="bi bi-buildings" aria-hidden="true"></i><input class="form-control farmer-form-control" asp-for="City" required /></div>
                        <span class="text-danger farmer-validation" asp-validation-for="City"></span>
                    </div>
                </div>
            </section>

            <section class="farmer-panel farmer-form-panel mt-4" aria-labelledby="pickup-preferences-heading">
                <div class="farmer-form-section-heading">
                    <span class="farmer-form-step">03</span>
                    <div>
                        <h2 id="pickup-preferences-heading">Pickup preferences</h2>
                        <p>Set the days, windows, and cutoff used for your farm stand.</p>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <label class="form-label farmer-form-label" asp-for="OperatingDays">Operating days</label>
                        <input class="form-control farmer-form-control" asp-for="OperatingDays" placeholder="Saturday, Sunday" />
                        <span class="farmer-form-hint">Separate days with commas.</span>
                        <span class="text-danger farmer-validation" asp-validation-for="OperatingDays"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label farmer-form-label" asp-for="OrderCutoffHours">Order cutoff</label>
                        <div class="input-group">
                            <input class="form-control farmer-form-control" asp-for="OrderCutoffHours" type="number" min="0" max="168" step="1" />
                            <span class="input-group-text">hours before pickup</span>
                        </div>
                        <span class="farmer-form-hint">Orders cannot move forward after this cutoff.</span>
                        <span class="text-danger farmer-validation" asp-validation-for="OrderCutoffHours"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label farmer-form-label" asp-for="PickupWindows">Pickup windows</label>
                        <textarea class="form-control farmer-form-control farmer-textarea" asp-for="PickupWindows" rows="3" placeholder="Saturday · 9:00 AM–12:00 PM"></textarea>
                        <span class="farmer-form-hint">Keep this concise; it is shown on your farm profile.</span>
                        <span class="text-danger farmer-validation" asp-validation-for="PickupWindows"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label farmer-form-label" asp-for="Latitude">Latitude</label>
                        <input class="form-control farmer-form-control" asp-for="Latitude" type="number" step="any" min="-90" max="90" placeholder="33.6844000" inputmode="decimal" />
                        <span class="farmer-form-hint">Used to place your pin on the marketplace map.</span>
                        <span class="text-danger farmer-validation" asp-validation-for="Latitude"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label farmer-form-label" asp-for="Longitude">Longitude</label>
                        <input class="form-control farmer-form-control" asp-for="Longitude" type="number" step="any" min="-180" max="180" placeholder="73.0479000" inputmode="decimal" />
                        <span class="farmer-form-hint">Add both values to show your stall on the map.</span>
                        <span class="text-danger farmer-validation" asp-validation-for="Longitude"></span>
                    </div>
                </div>
            </section>

            <section class="farmer-form-section">
                <div class="farmer-form-section-head">
                    <h2>Markets you sell at</h2>
                    <p>Customers can only pre-order from you at the markets you select here.</p>
                </div>

                @if (Model.Markets.Count == 0)
                {
                    <p class="farmer-form-hint">No markets are available yet. Ask an administrator to add one.</p>
                }
                else
                {
                    <div class="farmer-market-grid">
                        @foreach (var market in Model.Markets)
                        {
                            var isChecked = Model.MarketIds.Contains(market.Id) || market.IsSelected;
                            <label class="farmer-market-option">
                                <input type="checkbox" name="MarketIds" value="@market.Id" checked="@isChecked" data-market-lat="@market.Latitude" data-market-lon="@market.Longitude" />
                                <span class="farmer-market-copy">
                                    <strong>@market.Name</strong>
                                    <small>@market.City · @market.OperatingDays · @market.OpenTime–@market.CloseTime</small>
                                </span>
                            </label>
                        }
                    </div>
                    <span class="farmer-form-hint">Pick at least one market so shoppers can reserve your product.</span>
                }
            </section>

            <div class="farmer-form-actions farmer-profile-actions">
                <button class="farmer-btn farmer-btn-primary" type="submit"><i class="bi bi-check2" aria-hidden="true"></i> Save profile</button>
                <a class="farmer-btn farmer-btn-link" asp-area="Farmer" asp-controller="Dashboard" asp-action="Index">Cancel</a>
            </div>
        </div>
    </div>
</form>
