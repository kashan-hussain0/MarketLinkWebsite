@model OrderDetailViewModel
@{
    ViewData["Title"] = Model.OrderNumber;
}

<div class="farmer-page-header">
    <div>
        <a class="farmer-back-link" asp-area="Farmer" asp-controller="Order" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to orders</a>
        <div class="farmer-page-kicker mt-3">ORDER DETAILS</div>
        <div class="d-flex align-items-center flex-wrap gap-3">
            <h1 class="farmer-page-title mb-0">@Model.OrderNumber</h1>
            <span class="farmer-status farmer-status-@Model.StatusTone"><i class="bi @Model.StatusIcon" aria-hidden="true"></i>@Model.Status</span>
        </div>
        <p class="farmer-page-subtitle">Placed @Model.PlacedLabel</p>
    </div>
    <div class="farmer-page-actions">
        @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
        {
            <a class="farmer-btn farmer-btn-secondary" href="mailto:@Model.CustomerEmail"><i class="bi bi-envelope" aria-hidden="true"></i> Contact customer</a>
        }
        <a class="farmer-btn farmer-btn-secondary" asp-area="Farmer" asp-controller="Order" asp-action="Index">Back to orders</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <div class="farmer-alert farmer-alert-success" role="status">
        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
        <span>@Model.Notice</span>
    </div>
}

<div class="row g-4 align-items-start">
    <div class="col-12 col-xl-7">
        <section class="farmer-panel farmer-order-items-panel" aria-labelledby="items-heading">
            <div class="farmer-panel-header">
                <div>
                    <span class="farmer-panel-eyebrow">PICKUP CONTENTS</span>
                    <h2 class="farmer-panel-title" id="items-heading">Items in this order <span class="farmer-count-badge">@Model.Items.Count</span></h2>
                </div>
                <span class="farmer-pickup-label"><i class="bi bi-calendar2-week" aria-hidden="true"></i> @Model.PickupWindow</span>
            </div>
            <div class="farmer-order-lines">
                @foreach (var item in Model.Items)
                {
                    <div class="farmer-order-line">
                        <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                        <div class="farmer-order-line-copy">
                            <strong>@item.Name</strong>
                            <span>@item.Variant</span>
                            <small>Quantity: @item.Quantity</small>
                        </div>
                        <div class="farmer-order-line-price">
                            <strong>@item.LineTotal.ToString("C")</strong>
                            <span>@item.Price.ToString("C") each</span>
                        </div>
                    </div>
                }
            </div>
            <div class="farmer-order-totals">
                <div><span>Your item subtotal</span><strong>@Model.Subtotal.ToString("C")</strong></div>
                <div><span>@(Model.HasOtherFarmerItems ? "Other market items" : "MarketLink service fee")</span><strong>@Model.ServiceFee.ToString("C")</strong></div>
                <div class="farmer-total-grand"><span>Order total</span><strong>@Model.Total.ToString("C")</strong></div>
            </div>
        </section>

        <section class="farmer-panel mt-4" aria-labelledby="fulfillment-heading">
            <div class="farmer-panel-header">
                <div>
                    <span class="farmer-panel-eyebrow">FULFILLMENT</span>
                    <h2 class="farmer-panel-title" id="fulfillment-heading">Update order status</h2>
                </div>
                <i class="bi bi-arrow-repeat farmer-panel-header-icon" aria-hidden="true"></i>
            </div>
            <p class="farmer-muted-copy">Move this order through the pickup workflow. The customer receives an update when its status changes.</p>
            <div class="d-flex flex-wrap gap-2">
                @if (Model.CanAccept)
                {
                    <form method="post" asp-area="Farmer" asp-controller="Order" asp-action="Accept" asp-route-id="@Model.Id">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="farmer-btn farmer-btn-primary" type="submit"><i class="bi bi-check2" aria-hidden="true"></i> Accept order</button>
                    </form>
                }
                @if (Model.CanPrepare)
                {
                    <form method="post" asp-area="Farmer" asp-controller="Order" asp-action="Prepare" asp-route-id="@Model.Id">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="farmer-btn farmer-btn-primary" type="submit"><i class="bi bi-box-seam" aria-hidden="true"></i> Start preparing</button>
                    </form>
                }
                @if (Model.CanReady)
                {
                    <form method="post" asp-area="Farmer" asp-controller="Order" asp-action="Ready" asp-route-id="@Model.Id">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="farmer-btn farmer-btn-primary" type="submit"><i class="bi bi-check2-circle" aria-hidden="true"></i> Mark ready</button>
                    </form>
                }
                @if (Model.CanComplete)
                {
                    <form method="post" asp-area="Farmer" asp-controller="Order" asp-action="Complete" asp-route-id="@Model.Id">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="farmer-btn farmer-btn-primary" type="submit"><i class="bi bi-check2-all" aria-hidden="true"></i> Complete pickup</button>
                    </form>
                }
                @if (Model.CanDecline)
                {
                    <form method="post" asp-area="Farmer" asp-controller="Order" asp-action="Decline" asp-route-id="@Model.Id" class="d-flex flex-wrap gap-2 align-items-center">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="visually-hidden" for="decline-reason">Reason for declining</label>
                        <input id="decline-reason" class="form-control farmer-form-control" name="reason" placeholder="Optional reason" maxlength="300" />
                        <button class="farmer-btn farmer-btn-secondary" type="submit"><i class="bi bi-x-circle" aria-hidden="true"></i> Decline</button>
                    </form>
                }
                @if (Model.CanCancel)
                {
                    <form method="post" asp-area="Farmer" asp-controller="Order" asp-action="Cancel" asp-route-id="@Model.Id" class="d-flex flex-wrap gap-2 align-items-center ms-auto"
                          data-confirm="Cancel this order? The customer is notified straight away and the reserved items go back to your stock.">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="visually-hidden" for="cancel-reason">Reason for cancelling</label>
                        <input id="cancel-reason" class="form-control farmer-form-control" name="reason" placeholder="Reason shown to the customer" maxlength="300" required />
                        <button class="farmer-btn farmer-btn-danger" type="submit"><i class="bi bi-x-octagon" aria-hidden="true"></i> Cancel order</button>
                    </form>
                }
            </div>
            @if (Model.CanCancel)
            {
                <p class="farmer-muted-copy mt-3 mb-0"><i class="bi bi-info-circle" aria-hidden="true"></i> Cancelling releases the reserved stock and shows your reason to the customer. Once you accept an order the customer can no longer cancel it online.</p>
            }
        </section>

        <section class="farmer-panel mt-4" aria-labelledby="history-heading">
            <div class="farmer-panel-header">
                <div>
                    <span class="farmer-panel-eyebrow">HISTORY</span>
                    <h2 class="farmer-panel-title" id="history-heading">Status timeline</h2>
                </div>
            </div>
            @if (Model.StatusHistory.Count == 0)
            {
                <p class="farmer-muted-copy">No status changes have been recorded yet.</p>
            }
            else
            {
                <div class="farmer-order-history">
                    @foreach (var history in Model.StatusHistory)
                    {
                        <div class="farmer-order-history-item">
                            <span class="farmer-status farmer-status-@history.StatusTone"><i class="bi bi-check2" aria-hidden="true"></i>@history.Status</span>
                            <div><strong>@history.ChangedAtLabel</strong><p>@history.Note</p><small>@history.ChangedBy</small></div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <div class="col-12 col-xl-5">
        <aside class="farmer-order-side">
            <section class="farmer-panel" aria-labelledby="customer-heading">
                <div class="farmer-panel-header">
                    <div>
                        <span class="farmer-panel-eyebrow">CUSTOMER</span>
                        <h2 class="farmer-panel-title" id="customer-heading">Pickup details</h2>
                    </div>
                    <i class="bi bi-person-circle farmer-panel-header-icon" aria-hidden="true"></i>
                </div>
                <div class="farmer-customer-card">
                    <span class="farmer-large-initials">@Model.CustomerInitials</span>
                    <div><strong>@Model.CustomerName</strong><span>MarketLink neighbor</span></div>
                </div>
                <dl class="farmer-contact-list">
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                    {
                        <div><dt><i class="bi bi-envelope" aria-hidden="true"></i> Email</dt><dd><a href="mailto:@Model.CustomerEmail">@Model.CustomerEmail</a></dd></div>
                    }
                    <div><dt><i class="bi bi-telephone" aria-hidden="true"></i> Phone</dt><dd><a href="tel:@Model.CustomerPhone">@Model.CustomerPhone</a></dd></div>
                    <div><dt><i class="bi bi-geo-alt" aria-hidden="true"></i> Address</dt><dd>@Model.CustomerAddress</dd></div>
                </dl>
            </section>

            <section class="farmer-pickup-card mt-4" aria-labelledby="pickup-heading">
                <div class="farmer-pickup-icon"><i class="bi bi-shop-window" aria-hidden="true"></i></div>
                <div>
                    <span class="farmer-panel-eyebrow">PICKUP LOCATION</span>
                    <h2 id="pickup-heading">@Model.PickupLocation</h2>
                    <p>@Model.PickupAddress<br />@Model.CutoffLabel</p>
                </div>
                <a href="https://maps.google.com/?q=@Uri.EscapeDataString(Model.PickupAddress)" target="_blank" rel="noopener" class="farmer-map-link">Open map <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
            </section>

            <section class="farmer-panel farmer-payment-panel mt-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="farmer-payment-icon"><i class="bi bi-wallet2" aria-hidden="true"></i></span>
                    <div><span>Payment</span><strong>@Model.PaymentLabel</strong></div>
                    <i class="bi bi-check-circle-fill text-success ms-auto" aria-label="Payment status"></i>
                </div>
            </section>
        </aside>
    </div>
</div>
